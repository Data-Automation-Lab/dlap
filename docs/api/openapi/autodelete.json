  "paths": {
    "/api/v1/autodelete/restores/{softDeleteRecordId}": {
      "post": {
        "description": "A record whose bucket, prefix or container rule was applied (RULE_IN_FORCE, or AWAITING_PROOF) is restored by removing the rule; objects it already expired are gone. When DLAP's rule is not found the record ends RESTORE_FAILED (409, ruleRemoved false). A pending HARD_DELETE approval of the record is withdrawn by the service account on behalf of the caller (approvalWithdrawal in the answer).",
        "operationId": "restore",
        "parameters": [
          {
            "in": "path",
            "name": "softDeleteRecordId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "additionalProperties": {
                    "type": "object"
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Restore a soft-deleted asset before anything is deleted in the cloud",
        "tags": [
          "Restore"
        ]
      }
    },
    "/api/v1/autodelete/would-delete": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WouldDeletePage"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List the assets held for deletion and the rule that would delete each",
        "tags": [
          "Would delete"
        ]
      }
    },
