{
  "components": {
    "schemas": {
      "McpAccessRequest": {
        "properties": {
          "action": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          },
          "context": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "principalId": {
            "type": "string"
          },
          "resourceUri": {
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tier": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
