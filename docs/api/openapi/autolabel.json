{
  "components": {
    "schemas": {
      "ConfidenceConfig": {
        "properties": {
          "actionBelowThreshold": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "minThreshold": {
            "exclusiveMaximum": false,
            "exclusiveMinimum": false,
            "format": "double",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "FeedbackItem": {
        "properties": {
          "correctedLabel": {
            "type": "string"
          },
          "originalConfidence": {
            "format": "double",
            "type": "number"
          },
          "suggestedLabel": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "CONFIRMED",
              "REJECTED",
              "CORRECTED",
              "FLAGGED"
            ],
            "type": "string"
          },
          "userComment": {
            "type": "string"
          }
        },
        "required": [
          "suggestedLabel",
          "type"
        ],
        "type": "object"
      },
      "LabelAgentKpis": {
        "properties": {
          "activeModels": {
            "format": "int32",
            "type": "integer"
          },
          "appliedLabelsLast24h": {
            "format": "int32",
            "type": "integer"
          },
          "appliedLabelsTotal": {
            "format": "int32",
            "type": "integer"
          },
          "assetsProcessed": {
            "format": "int32",
            "type": "integer"
          },
          "assetsProcessedLast24h": {
            "format": "int32",
            "type": "integer"
          },
          "averageProcessingTime": {
            "format": "double",
            "type": "number"
          },
          "errorRate": {
            "format": "double",
            "type": "number"
          },
          "mlPoliciesActive": {
            "format": "int32",
            "type": "integer"
          },
          "modelAccuracy": {
            "format": "double",
            "type": "number"
          },
          "rulePoliciesActive": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "LabelSuggestionDTO": {
        "properties": {
          "category": {
            "type": "string"
          },
          "confidence": {
            "format": "double",
            "type": "number"
          },
          "labelName": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LabelingFeedbackRequest": {
        "properties": {
          "additionalContext": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "assetId": {
            "minLength": 1,
            "type": "string"
          },
          "feedbackItems": {
            "items": {
              "$ref": "#/components/schemas/FeedbackItem"
            },
            "minItems": 1,
            "type": "array"
          },
          "labelingJobId": {
            "minLength": 1,
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "feedbackItems",
          "labelingJobId"
        ],
        "type": "object"
      },
      "LabelingFeedbackResponse": {
        "properties": {
          "assetId": {
            "type": "string"
          },
          "feedbackId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "processedAt": {
            "format": "date-time",
            "type": "string"
          },
          "receivedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "LabelingJobListResponse": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/LabelingJobStatusResponse"
            },
            "type": "array"
          },
          "last": {
            "type": "boolean"
          },
          "pageNumber": {
            "format": "int32",
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "LabelingJobRequest": {
        "properties": {
          "jobName": {
            "type": "string"
          },
          "jobParameters": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "overrideMlConfig": {
            "$ref": "#/components/schemas/MLConfigRequest"
          },
          "scope": {
            "$ref": "#/components/schemas/LabelingScope"
          }
        },
        "required": [
          "jobName",
          "scope"
        ],
        "type": "object"
      },
      "LabelingJobResponse": {
        "properties": {
          "assetId": {
            "type": "string"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "processingTimeMs": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/LabelSuggestionDTO"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "LabelingJobStatusResponse": {
        "properties": {
          "assetsFailed": {
            "format": "int32",
            "type": "integer"
          },
          "assetsProcessed": {
            "format": "int32",
            "type": "integer"
          },
          "assetsSuccessfullyLabeled": {
            "format": "int32",
            "type": "integer"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          },
          "currentStageDescription": {
            "type": "string"
          },
          "errorMessages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "jobId": {
            "type": "string"
          },
          "jobName": {
            "type": "string"
          },
          "labelSummary": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "type": "object"
          },
          "lastUpdatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "progressPercentage": {
            "format": "double",
            "type": "number"
          },
          "resultsLink": {
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string"
          },
          "totalAssetsToProcess": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "LabelingScope": {
        "properties": {
          "assetCriteria": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "assetGroupId": {
            "type": "string"
          },
          "assetIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cloudConnectionId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "MLConfigRequest": {
        "properties": {
          "additionalParameters": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "apiKey": {
            "maxLength": 4096,
            "minLength": 0,
            "type": "string"
          },
          "baseUrl": {
            "maxLength": 2048,
            "minLength": 0,
            "pattern": "(https?://[!-~]+)?",
            "type": "string"
          },
          "confidenceConfig": {
            "$ref": "#/components/schemas/ConfidenceConfig"
          },
          "modelName": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "promptTemplate": {
            "maxLength": 20000,
            "minLength": 0,
            "type": "string"
          },
          "providerType": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "suggestionConfig": {
            "$ref": "#/components/schemas/SuggestionConfig"
          }
        },
        "type": "object"
      },
      "Pageable": {
        "properties": {
          "page": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "sort": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "RecentLabelActivity": {
        "properties": {
          "assetName": {
            "type": "string"
          },
          "confidence": {
            "format": "double",
            "type": "number"
          },
          "details": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "labelsApplied": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "method": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RuleActivity": {
        "properties": {
          "assetsAffected": {
            "format": "int32",
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "hitCount": {
            "format": "int32",
            "type": "integer"
          },
          "lastTriggered": {
            "type": "string"
          },
          "ruleName": {
            "type": "string"
          },
          "successRate": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "SuggestionConfig": {
        "properties": {
          "includeConfidenceScores": {
            "type": "boolean"
          },
          "maxSuggestions": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TopAppliedLabel": {
        "properties": {
          "category": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
