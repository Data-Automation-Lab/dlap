    "/api/v1/autolabel/labeling/jobs": {
      "get": {
        "description": "Retrieves a paginated list of labeling jobs",
        "operationId": "getLabelingJobs",
        "parameters": [
          {
            "in": "query",
            "name": "pageable",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          },
          {
            "description": "Filter by job status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by user ID",
            "in": "query",
            "name": "userId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LabelingJobListResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get labeling jobs",
        "tags": [
          "Auto-Labeling"
        ]
      },
      "post": {
        "description": "Creates a new auto-labeling job for the specified assets",
        "operationId": "createLabelingJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelingJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LabelingJobResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Create a labeling job",
        "tags": [
          "Auto-Labeling"
        ]
      }
    },
