  "info": {
    "description": "API for managing compliance reports, checks, and asset compliance status.",
    "license": {
      "name": "Apache 2.0",
      "url": "http://springdoc.org"
    },
    "termsOfService": "http://swagger.io/terms/",
    "title": "DLAP AutoCompliance Service API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/v1/compliance/assets/{assetId}/status": {
      "get": {
        "description": "Retrieves the overall compliance status and recent findings for a specific asset.",
        "operationId": "getAssetComplianceStatus",
        "parameters": [
          {
            "description": "ID of the asset (e.g., cloud resource ID)",
            "in": "path",
            "name": "assetId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AssetComplianceStatusDTO"
                }
              }
            },
            "description": "Successfully retrieved asset compliance status."
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AssetComplianceStatusDTO"
                }
              }
            },
            "description": "Asset ID not found or no compliance data available."
          }
        },
        "summary": "Get compliance status for an asset",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/controls": {
      "get": {
        "description": "Provides a list of all configured and typically enabled compliance controls that can be evaluated.",
        "operationId": "listAvailableControls",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ComplianceControlDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved compliance controls"
          }
        },
        "summary": "List available compliance controls",
        "tags": [
          "Compliance API"
        ]
      },
      "post": {
        "description": "Creates a new compliance control that can be evaluated. Controls should be added through this API instead of being hardcoded.",
        "operationId": "createComplianceControl",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplianceControlDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Compliance control created successfully"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Invalid request data"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Control ID already exists"
          }
        },
        "summary": "Create a new compliance control",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/controls/evaluations/{jobId}": {
      "get": {
        "description": "Returns status for a job created by POST /controls/{controlId}/evaluate.",
        "operationId": "getControlEvaluationJobStatus",
        "parameters": [
          {
            "description": "Evaluation job ID",
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ControlEvaluationResponseDTO"
                }
              }
            },
            "description": "Job found"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ControlEvaluationResponseDTO"
                }
              }
            },
            "description": "Job not found"
          }
        },
        "summary": "Get control evaluation job status",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/controls/{controlId}": {
      "delete": {
        "description": "Deletes a compliance control. This will disable the control from being evaluated.",
        "operationId": "deleteComplianceControl",
        "parameters": [
          {
            "description": "Control ID to delete",
            "in": "path",
            "name": "controlId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Compliance control deleted successfully"
          },
          "404": {
            "description": "Control not found"
          }
        },
        "summary": "Delete a compliance control",
        "tags": [
          "Compliance API"
        ]
      },
      "put": {
        "description": "Updates an existing compliance control. Only enabled controls can be updated.",
        "operationId": "updateComplianceControl",
        "parameters": [
          {
            "description": "Control ID to update",
            "in": "path",
            "name": "controlId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplianceControlDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Compliance control updated successfully"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Invalid request data"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceControlDTO"
                }
              }
            },
            "description": "Control not found"
          }
        },
        "summary": "Update an existing compliance control",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/controls/{controlId}/evaluate": {
      "post": {
        "description": "Triggers the asynchronous evaluation of a specific compliance control.",
        "operationId": "evaluateControl",
        "parameters": [
          {
            "description": "Unique identifier of the control to evaluate",
            "in": "path",
            "name": "controlId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlEvaluationRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ControlEvaluationResponseDTO"
                }
              }
            },
            "description": "Control evaluation request accepted."
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ControlEvaluationResponseDTO"
                }
              }
            },
            "description": "Invalid request (e.g., missing parameters, control not enabled)"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ControlEvaluationResponseDTO"
                }
              }
            },
            "description": "Control ID not found"
          }
        },
        "summary": "Evaluate a compliance control",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/heatmap": {
      "get": {
        "description": "Retrieves compliance heatmap data by regulation and category.",
        "operationId": "getComplianceHeatmap",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ComplianceHeatmapDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved compliance heatmap data"
          }
        },
        "summary": "Get compliance heatmap data",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/kpis": {
      "get": {
        "description": "Retrieves key performance indicators for compliance monitoring dashboard.",
        "operationId": "getComplianceKpis",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceKpisDTO"
                }
              }
            },
            "description": "Successfully retrieved compliance KPIs"
          }
        },
        "summary": "Get compliance KPIs for dashboard",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/regulations": {
      "get": {
        "description": "Retrieves list of monitored regulations with their compliance status.",
        "operationId": "getMonitoredRegulations",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MonitoredRegulationDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved monitored regulations"
          }
        },
        "summary": "Get monitored regulations",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/reports": {
      "get": {
        "description": "Provides a list of all configured compliance report types that can be generated.",
        "operationId": "listAvailableReportDefinitions",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ComplianceReportDefinitionDTO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved report definitions"
          }
        },
        "summary": "List available compliance report definitions",
        "tags": [
          "Compliance API"
        ]
      },
      "post": {
        "description": "Creates a new compliance report definition that can be used for report generation. Report definitions should be added through this API instead of being hardcoded.",
        "operationId": "createComplianceReportDefinition",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComplianceReportDefinitionDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceReportDefinitionDTO"
                }
              }
            },
            "description": "Compliance report definition created successfully"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceReportDefinitionDTO"
                }
              }
            },
            "description": "Invalid request data"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceReportDefinitionDTO"
                }
              }
            },
            "description": "Report type already exists"
          }
        },
        "summary": "Create a new compliance report definition",
        "tags": [
          "Compliance API"
        ]
      }
    },
    "/api/v1/compliance/reports/jobs": {
