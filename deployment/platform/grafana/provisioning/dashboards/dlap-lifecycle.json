{
  "uid": "dlap-lifecycle",
  "title": "DLAP Lifecycle",
  "description": "The DLAP meters: policy decisions, the MCP enforcement point, discovery, the catalog event consumers, drift and log ingest. A series appears after the first event of its kind.",
  "tags": [
    "dlap"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "PDP decisions per second",
      "description": "dlap.pdp.decisions.total from da-policyengine.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:pdp_decisions:rate5m",
          "refId": "A",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PDP evaluation time (mean)",
      "description": "dlap.pdp.evaluation.duration from da-policyengine.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:pdp_evaluation_duration_seconds:mean5m",
          "refId": "A",
          "legendFormat": "evaluation"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MCP PEP decisions per second",
      "description": "dlap.mcppep.decisions.total from da-mcp-pep. failClosed=true: decided without the PDP.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:mcppep_decisions:rate5m",
          "refId": "A",
          "legendFormat": "allow={{allow}} failClosed={{failClosed}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Decisions without the PDP (10 min)",
      "description": "Alert: McpPepFailClosed.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "sum(increase(dlap_mcppep_decisions_total{failClosed=\"true\"}[10m])) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Events not published (1 h)",
      "description": "Alerts: PolicyDecisionEventsNotPublished, PolicyActionEventsNotPublished.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "sum(increase(policyengine_access_decision_publish_failures_total[1h])) + sum(increase(policyengine_send_failures_total[1h])) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Assets discovered per second",
      "description": "dlap.discovery.assets.total from da-discovery.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:discovery_assets:rate5m",
          "refId": "A",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Catalog events per second",
      "description": "dlap.catalog.events from da-catalog: applied, duplicate, unmatched, skipped.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:catalog_events:rate5m",
          "refId": "A",
          "legendFormat": "{{consumer}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Drift findings per hour",
      "description": "dlap.drift.findings.total from da-reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "dlap:drift_findings:rate1h * 3600",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Log events deduplicated per second",
      "description": "dlap.logingest.dedup.hits from da-logingest.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dlap-prometheus"
          },
          "expr": "sum(rate(dlap_logingest_dedup_hits_total[5m]))",
          "refId": "A",
          "legendFormat": "dedup hits"
        }
      ]
    }
  ]
}
