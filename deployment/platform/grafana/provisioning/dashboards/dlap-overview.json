    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Alert: KafkaConsumerLagHigh above 1000 for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
