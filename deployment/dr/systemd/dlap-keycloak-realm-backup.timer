# /etc/systemd/system/dlap-keycloak-realm-backup.timer (DR-03, Q-751): the daily start of the service of the same name.
[Unit]
Description=Daily DLAP Keycloak realm backup

[Timer]
# 03:10 UTC. Keycloak is down for the length of a container copy, so pick a quiet hour.
OnCalendar=*-*-* 03:10:00 UTC
# A host that was off at 03:10 runs the backup when it is next up.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
