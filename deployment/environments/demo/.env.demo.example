# DLAP hosted-demo environment (DEMO-01).
#
# Copy to .env.demo in this folder, fill it in, and never commit the copy (the folder's .gitignore
# excludes it). up.sh reads it and refuses to start while a value is missing, still says CHANGE_ME,
# or is a default that the quickstart publishes. The settings under "Local rehearsal" make the same
# stack run on a workstation; for the public host leave them commented out.
#
#   cp .env.demo.example .env.demo
#   ./up.sh --check
#   ./up.sh

# --- Hostnames: a DLAP-owned domain ------------------------------------------------------------------

# The SPA and the API, and the identity provider. Two DNS A records point at the VM's static IP.
DEMO_APP_HOST=demo.CHANGE_ME.example
DEMO_ID_HOST=id.CHANGE_ME.example

# Optional: domains the demo must never be served from, comma-separated (for example a production site
# on the same hosting account). up.sh refuses any host name that contains one.
DEMO_FORBIDDEN_HOSTS=

# auto: Caddy obtains public certificates (needs the two DNS records, and TCP 80 and 443 open).
DEMO_TLS=auto
# While testing the certificates, use the staging directory to stay clear of the rate limits:
# DEMO_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Secrets: every one is required -----------------------------------------------------------------

# Password of the PostgreSQL superuser. The services do not use it; each connects as its own user.
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser

# One password per database role (SEC-12). The PostgreSQL init script creates each role with its password when
# the volume is new, and the service of that name gets the same value; the services run under the prod
# profile and refuse a published default. Eleven service roles and the two platform roles (dlap_monitor for
# the Postgres exporter, dlap_backup for backups) each need a value of their own. up.sh refuses a
# placeholder, a published default and a value used twice. deployment/platform/database/gen-db-passwords.sh
# .env.demo writes all thirteen with random values and changes nothing that already has one. A PostgreSQL
# volume from before SEC-12 keeps its old passwords until deployment/platform/database/upgrades/
# sync-database-roles.sh has run in the database container.
DLAP_COMMON_DB_PASSWORD=CHANGE_ME_dlap_common_db_password
DA_DISCOVERY_DB_PASSWORD=CHANGE_ME_da_discovery_db_password
DA_CATALOG_DB_PASSWORD=CHANGE_ME_da_catalog_db_password
DA_POLICYENGINE_DB_PASSWORD=CHANGE_ME_da_policyengine_db_password
DA_REPORTING_DB_PASSWORD=CHANGE_ME_da_reporting_db_password
DA_AUTOLABEL_DB_PASSWORD=CHANGE_ME_da_autolabel_db_password
DA_AUTOARCHIVAL_DB_PASSWORD=CHANGE_ME_da_autoarchival_db_password
DA_AUTODELETE_DB_PASSWORD=CHANGE_ME_da_autodelete_db_password
DA_AUTOCOMPLIANCE_DB_PASSWORD=CHANGE_ME_da_autocompliance_db_password
DA_ADMIN_DB_PASSWORD=CHANGE_ME_da_admin_db_password
DA_LOGINGEST_DB_PASSWORD=CHANGE_ME_da_logingest_db_password
DLAP_MONITOR_DB_PASSWORD=CHANGE_ME_dlap_monitor_db_password
DLAP_BACKUP_DB_PASSWORD=CHANGE_ME_dlap_backup_db_password

# Keycloak master-realm console account. Reach the console through an SSH tunnel only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin

# Secret of the dlap-backend client, used for service-to-service calls. The overlay hands the same
# value to Keycloak, whose realm import reads it. At least 24 random characters: openssl rand -hex 24
DLAP_BACKEND_CLIENT_SECRET=CHANGE_ME_backend_client_secret

# Optional: secret of the dlap-mcp-gateway client, which only the quickstart (dev) realm imports; the
# demo realm has none. Leave it unset for the demo. If you set it, up.sh refuses the published
# default and a CHANGE_ME placeholder.
# DLAP_MCP_GATEWAY_CLIENT_SECRET=CHANGE_ME_mcp_gateway_client_secret

# Optional: password of the "keycloak" database role that the Keycloak overlay creates. Unset, it is
# KEYCLOAK_ADMIN_PASSWORD. Set it to keep the two apart; then it must be a real secret (up.sh refuses a
# CHANGE_ME value). Fixed when the Postgres volume is created, so decide before the first start.
# KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_database

# AES-256 key of da-admin-service. Needed only with the plus profile. 64 hex characters:
#   openssl rand -hex 32
# DLAP_ENCRYPTION_KEY=CHANGE_ME_64_hex_characters

# --- Guards ---------------------------------------------------------------------------------------------

# Only read when keycloak/docker-compose.demo.keycloak.yml (DEMO-02) is missing from the folder, which
# it is not in this repository. Then the demo would import the quickstart Keycloak realm, which seeds
# users with a published password, and up.sh refuses to start unless this is 1. A rehearsal on your own
# machine only, never on a host with a public address. Leave it 0.
DEMO_ALLOW_DEV_REALM=0

# Optional compose profiles. plus: da-admin-service and da-autocompliance (about 1 GB more).
COMPOSE_PROFILES=

# --- Third-party assets of the UI ------------------------------------------------------------------------

# The UI hotlinks Google Fonts (IBM Plex), Unsplash and Cloudinary pictures. The content security policy
# blocks them by default: fonts fall back to the system fonts and the sign-in page loses its pictures,
# and no visitor's browser calls those hosts. To allow them (decision for the founder), uncomment:
# DEMO_CSP_STYLE_EXTRA=https://fonts.googleapis.com
# DEMO_CSP_FONT_EXTRA=https://fonts.gstatic.com
# DEMO_CSP_IMG_EXTRA=https://images.unsplash.com https://res.cloudinary.com

# --- Where things live ----------------------------------------------------------------------------------

# The compose project. Fixed container names in the quickstart files mean one demo per Docker host.
COMPOSE_PROJECT_NAME=dlap-demo

# The built SPA (scripts/build-spa.sh writes it). Relative paths start at deployment/environments/dev.
# DEMO_SPA_DIR=../demo/spa

# Golden dump, maintenance flag, measurements and the last reset result. Never committed.
# DEMO_STATE_DIR=../demo/state

# The project id the GCP client libraries are built for. Nothing is called; any value works.
DEMO_GCP_PROJECT_ID=dlap-demo-project

# --- Local rehearsal (uncomment all of this on a workstation; the last assignment of a name wins) ------
# Plain HTTP for the app and a local certificate authority, on ports that are free on a workstation.
# The demo is then at http://localhost:18080 and https://localhost:18443, Keycloak at
# https://id.localhost:18443. Never set DEMO_APP_HTTP_ADDRESS on the public host.
# DEMO_APP_HOST=localhost
# DEMO_ID_HOST=id.localhost
# DEMO_TLS=internal
# DEMO_APP_HTTP_ADDRESS=http://localhost
# DEMO_ID_PORT_SUFFIX=:18443
# DEMO_BIND_ADDR=127.0.0.1
# DEMO_HTTP_PORT=18080
# DEMO_HTTPS_PORT=18443
# DEMO_ALLOW_DEV_REALM=1
