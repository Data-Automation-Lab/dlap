# DLAP read-only pilot environment (DEP-01).
#
# Copy to .env.pilot in this folder, fill it in, and never commit the copy (the folder's .gitignore
# excludes it). up.sh reads it and refuses to start while a value is missing, still says CHANGE_ME,
# or is a default that the quickstart publishes.
#
#   cp .env.pilot.example .env.pilot
#   ./up.sh --check
#   ./up.sh

# --- Secrets: every one is required ---------------------------------------------------------------

# Password of the PostgreSQL superuser. The services do not use it; each connects as its own user, and
# monitoring and backup have roles of their own (below).
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser

# One password per database role (SEC-12). The PostgreSQL init script creates each role with its password
# when the volume is new, and the service of that name gets the same value. All eleven service roles and the
# two platform roles need a value of their own: up.sh refuses the placeholder, a published default and a
# value used twice, and every service refuses to start under the prod profile with a default.
# deployment/platform/database/gen-db-passwords.sh .env.pilot fills in all thirteen with random values and
# changes nothing that already has one. On a PostgreSQL volume from before SEC-12, up.sh runs
# deployment/platform/database/upgrades/sync-database-roles.sh to set these passwords and to create the
# two platform roles.
DLAP_COMMON_DB_PASSWORD=CHANGE_ME_dlap_common_db_password
DA_DISCOVERY_DB_PASSWORD=CHANGE_ME_da_discovery_db_password
DA_CATALOG_DB_PASSWORD=CHANGE_ME_da_catalog_db_password
DA_POLICYENGINE_DB_PASSWORD=CHANGE_ME_da_policyengine_db_password
DA_REPORTING_DB_PASSWORD=CHANGE_ME_da_reporting_db_password
DA_AUTOLABEL_DB_PASSWORD=CHANGE_ME_da_autolabel_db_password
DA_AUTOARCHIVAL_DB_PASSWORD=CHANGE_ME_da_autoarchival_db_password
DA_AUTODELETE_DB_PASSWORD=CHANGE_ME_da_autodelete_db_password
DA_AUTOCOMPLIANCE_DB_PASSWORD=CHANGE_ME_da_autocompliance_db_password
DA_ADMIN_DB_PASSWORD=CHANGE_ME_da_admin_db_password
DA_LOGINGEST_DB_PASSWORD=CHANGE_ME_da_logingest_db_password
# The Postgres exporter (monitoring profile) connects as dlap_monitor: pg_monitor and nothing else.
DLAP_MONITOR_DB_PASSWORD=CHANGE_ME_dlap_monitor_db_password
# The backup agent (docker-compose.pilot.backup.yml) connects as dlap_backup: REPLICATION and
# pg_read_all_data, no superuser rights.
DLAP_BACKUP_DB_PASSWORD=CHANGE_ME_dlap_backup_db_password

# Keycloak master-realm console account. da-admin-service uses the same pair to call the Keycloak
# admin API, so they move together. Keycloak creates the account at its first start only, as a
# temporary administrator; replace it as deployment/platform/keycloak/production/README.md says.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin

# Password of the PostgreSQL role "keycloak", which owns the database that holds Keycloak's accounts,
# one-time-code devices and events. Its own secret, not the admin password (Q-541). The role is created
# with it when the PostgreSQL volume is new. A pilot started before this variable was required keeps the
# old password in that role (it was KEYCLOAK_ADMIN_PASSWORD): either put that value here, or change the
# role first (pilot README, "Keycloak database password"). openssl rand -hex 24
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password

# Secret of the dlap-backend client, used for service-to-service calls. The overlay hands the same
# value to Keycloak, whose realm import reads it. At least 24 random characters: openssl rand -hex 24
DLAP_BACKEND_CLIENT_SECRET=CHANGE_ME_backend_client_secret

# Secret of the dlap-mcp-gateway client, which the imported realm carries for MCP gateways (da-mcp-pep).
# The overlay hands the same value to Keycloak. At least 24 random characters: openssl rand -hex 24
DLAP_MCP_GATEWAY_CLIENT_SECRET=CHANGE_ME_mcp_gateway_client_secret

# AES-256 key that encrypts stored cloud-connection credentials. Exactly 64 hex characters:
#   openssl rand -hex 32
# Keep a copy outside the VM; without it stored connections cannot be read.
DLAP_ENCRYPTION_KEY=CHANGE_ME_64_hex_characters

# --- The customer's cloud --------------------------------------------------------------------------

# GCP project that the discovery service is constructed for. Required even when you scan nothing on
# GCP; then any project id works.
GCP_PROJECT_ID=CHANGE_ME_gcp_project_id

# Audit-log sources. Both are off. A source needs its flag, and the prod profile (already set by the
# overlay) loads it. Credentials come from the VM's own service identity, never from this file.
DLAP_LOGINGEST_GCP_ENABLED=false
DLAP_LOGINGEST_GCP_PROJECTS=
DLAP_LOGINGEST_AWS_ENABLED=false
DLAP_LOGINGEST_AWS_REGIONS=

# --- Where people reach the pilot ------------------------------------------------------------------

# The pilot serves HTTPS only (docker-compose.pilot.tls.yml, applied by up.sh with the other overlays of
# this folder). Keycloak signs every token with one issuer and the services check it, so the three
# addresses below must be the same https origin, the address browsers type. up.sh refuses to start when
# they differ or when the key material is missing.
#
# The values below suit a rehearsal through an SSH tunnel: create the key material, start the pilot, then
#   deployment/environments/pilot/tls/gen-certs.sh --public-host localhost
#   ssh -L 8443:127.0.0.1:8443 <vm>        and open https://localhost:8443
#
# For a pilot reached by name, put that name in all three addresses and in the certificate, for example
#   deployment/environments/pilot/tls/gen-certs.sh --public-host pilot.example.com
#   PILOT_PUBLIC_ORIGIN=https://pilot.example.com   (a non-default port goes in the origin: ...:8443)
# and set PILOT_TLS_BIND_ADDRESS to the VM's address (or 0.0.0.0) to open the entry point to the network.
PILOT_PUBLIC_ORIGIN=https://localhost:8443
DLAP_PILOT_ID_URL=https://localhost:8443
DLAP_PILOT_APP_URL=https://localhost:8443

# More TLS overlay settings. All are optional; the lines show the defaults.
#   PILOT_TLS_BIND_ADDRESS=127.0.0.1   host address of the entry point (loopback: reachable through an SSH tunnel only)
#   PILOT_TLS_DIR=                     folder gen-certs.sh wrote (default: tls/generated next to up.sh); a relative
#                                      path is relative to deployment/environments/dev
#   PILOT_JWT_AUDIENCE=dlap-api        audience the services require and the realm writes into dlap-ui and
#                                      dlap-backend tokens
PILOT_TLS_PORT=8443

# The realm's "Require SSL" mode is not set here: the TLS overlay imports realm dlap with sslRequired
# "all", so Keycloak refuses plain HTTP also from private addresses. A realm that exists already keeps
# its setting (deployment/platform/keycloak/production/README.md, "Require SSL").

# --- Optional parts -----------------------------------------------------------------------------------

# Optional compose profiles, comma separated:
#   actions     da-autoarchival and da-autodelete (deletes stay dry runs, archival stays mocked)
#   llm         Ollama, for an LLM labelling provider instead of the rules provider
#   monitoring  Prometheus and Grafana (then GRAFANA_ADMIN_PASSWORD is required as well)
COMPOSE_PROFILES=
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin

# Principal identity map for the drift report (enforcement-contract.md section 6.1). A CSV file with the
# header provider,principal,subject that maps cloud principals to DLAP subjects; da-reporting reads it at
# start and owns every key it names. Unset, the pilot mounts an empty map (every principal unmapped, so a
# governed read whose subject differs from the log principal reports UNENFORCED_READ). Start from
# deployment/examples/identity-map/identity-map.example.csv. Use an absolute path; a relative one is
# relative to deployment/environments/dev.
# PILOT_IDENTITY_MAP_FILE=/etc/dlap-pilot/identity-map.csv
