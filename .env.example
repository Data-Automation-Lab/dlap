# DLAP example environment.
#
# Copy to `.env` at the repo root:  cp .env.example .env
#
# Docker Compose does NOT pick this file up on its own: it reads `.env` from the
# directory of the compose file (deployment/environments/dev), not the repo root.
# Pass it explicitly, from the repo root:
#
#   docker compose --env-file .env \
#     -f deployment/environments/dev/docker-compose.yml \
#     -f deployment/environments/dev/docker-compose.microservices.yml \
#     up -d --build
#
# Everything above section 7 is read by the dev compose pair. Section 7 only applies when
# you run a single service on the host (./gradlew :<service>:bootRun); the dev
# compose sets its own values for those and ignores them.
#
# Every value below is a non-secret development placeholder. Change the secrets
# before the stack is reachable by anyone else. Never commit `.env`.
#
# Production (SEC-05): these placeholders are published in the repository. Under
# SPRING_PROFILES_ACTIVE=prod each service checks its own settings at start-up and refuses
# to start with an empty secret or one of them (change-me-dev-only, admin, changeme,
# Password123!, the sample encryption key). deployment/PRODUCTION.md section 1 lists the
# secrets and what the guard does.

# === 1. Shared infrastructure ================================================
POSTGRES_PASSWORD=dlap
# Database role passwords (SEC-12, ADR-0140). The init script gives each role the value of
# its own variable; unset or empty, the role keeps its published development password
# (<database>_pass, dlap_monitor_pass, dlap_backup_pass), which is all the quickstart needs.
# The dev pair passes each one to PostgreSQL and to its service. Under the prod profile the
# services refuse the published passwords; the pilot and the demo require all 13, and
# deployment/platform/database/gen-db-passwords.sh writes random values into an env file.
# Set them before the database volume is first created, or run
# deployment/platform/database/upgrades/sync-database-roles.sh on an existing volume.
# DLAP_COMMON_DB_PASSWORD=
# DA_DISCOVERY_DB_PASSWORD=
# DA_CATALOG_DB_PASSWORD=
# DA_POLICYENGINE_DB_PASSWORD=
# DA_REPORTING_DB_PASSWORD=
# DA_AUTOLABEL_DB_PASSWORD=
# DA_AUTOARCHIVAL_DB_PASSWORD=
# DA_AUTODELETE_DB_PASSWORD=
# DA_AUTOCOMPLIANCE_DB_PASSWORD=
# DA_ADMIN_DB_PASSWORD=
# DA_LOGINGEST_DB_PASSWORD=
# Read-only monitoring role of postgres-exporter (pg_monitor) and the backup agent's role.
# DLAP_MONITOR_DB_PASSWORD=
# DLAP_BACKUP_DB_PASSWORD=
# Bootstrap admin of the Keycloak master realm. da-admin-service uses the same
# pair to drive the Keycloak admin API, so the two always move together.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Only used by the optional `monitoring` compose profile (Grafana).
GRAFANA_ADMIN_PASSWORD=changeme
# Optional Keycloak social login (identity providers). Unset, the compose uses
# inert placeholders and the social buttons do not work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# === 2. Service-to-service auth ==============================================
# Secret of the dlap-backend Keycloak client (client-credentials). Every service's
# Feign interceptor reads it, and the realm import
# (deployment/platform/keycloak/keycloak-import/dlap-realm.json) sets the same
# value. Change both together. Dev default only.
# The compose pair passes it to Keycloak (realm import) and, as DLAP_SERVICE_AUTH_CLIENT_SECRET,
# to every service that calls another service. It is not part of SPRING_APPLICATION_JSON.
DLAP_BACKEND_CLIENT_SECRET=change-me-dev-only
# Secret of the dlap-mcp-gateway Keycloak client (client-credentials, the MCP gateway of
# da-mcp-pep). The compose pair passes it to Keycloak, whose realm import reads it. Dev default only;
# the demo and pilot launchers refuse the published value.
DLAP_MCP_GATEWAY_CLIENT_SECRET=change-me-dev-only

# === 3. da-admin-service credential store ====================================
# AES-256 key. It must resolve to EXACTLY 32 bytes or the service refuses to
# start. Two accepted forms:
#   64 hex characters (preferred): openssl rand -hex 32
#   32 raw characters (the placeholder below): kept for backward compatibility
DLAP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# === 4. da-autolabel / da-autodelete =========================================
# Model pulled once by the ollama-model-pull container. The dev stack labels with the
# deterministic rules provider (dlap.autolabel.llm-provider=rules), which needs no model,
# so this pull is only a hedge for switching da-autolabel to Ollama.
OLLAMA_MODEL=llama3.2:1b
# Dev default is true: cloud deletion is a dry run (rows are stamped
# "DRY-RUN: no cloud call"). Set false only against a sandbox you can lose.
DLAP_AUTODELETE_DRY_RUN_CLOUD_DELETE=true

# === JWT validation (all services with an API) ===============================
# Off by default so that the dual-issuer dev setup works: the browser gets tokens from
# http://localhost:8180, the services get theirs from http://keycloak:8080, and both are signed
# by the same realm key. Production turns both checks on (deployment/PRODUCTION.md section 4).
# EXPECTED_ISSUER takes one issuer or several separated by commas, exactly as the tokens carry
# them in `iss`. Under the prod profile the boot guard warns while a check is off and refuses
# to start when DLAP_SECURITY_DEV_SECRET_GUARD_STRICT=true.
DLAP_SECURITY_JWT_VALIDATE_ISSUER=false
DLAP_SECURITY_JWT_EXPECTED_ISSUER=
DLAP_SECURITY_JWT_VALIDATE_AUDIENCE=false
DLAP_SECURITY_JWT_EXPECTED_AUDIENCE=

# === 5. AWS (da-discovery): one variable set =================================
# Off by default. These five variables are the only AWS switches for discovery;
# da-discovery's config/application.yml binds them to the properties the code
# reads (cloud.provider.aws.*, aws.region).
#   Real AWS:   DLAP_AWS_ENABLED=true and leave ENDPOINT, ACCESS_KEY and SECRET_KEY
#               empty. The AWS SDK default credential chain inside the container
#               then applies (for example an instance role).
#   Static keys (laptop): set ACCESS_KEY and SECRET_KEY; leave ENDPOINT empty.
#   LocalStack: docker compose ... --profile aws up -d localstack, then
#               ENDPOINT=http://localstack:4566, ACCESS_KEY=test, SECRET_KEY=test.
# The dev compose maps DLAP_AWS_ENABLED onto CLOUD_PROVIDER_AWS_ENABLED, because the
# dev Spring profile pins the YAML value to false. Running da-discovery on the host
# under the dev profile? Export CLOUD_PROVIDER_AWS_ENABLED=true as well.
DLAP_AWS_ENABLED=false
DLAP_AWS_REGION=us-east-1
DLAP_AWS_ENDPOINT=
DLAP_AWS_ACCESS_KEY=
DLAP_AWS_SECRET_KEY=

# === 6. da-logingest: real audit-log sources and the demo seeder =============
# All off by default. A source needs BOTH its enable flag AND its Spring profile:
# the GCP source loads only under profile `gcp` (or `prod`), the AWS source only
# under `aws` (or `prod`). The dev compose runs profile `dev`, so add the profile
# here when you turn a source on, for example DLAP_LOGINGEST_PROFILES=dev,gcp.
DLAP_LOGINGEST_PROFILES=dev
#
# GCP Cloud Logging (ADR-0023). Credentials come from Application Default
# Credentials: workload identity on GCE or GKE, or GOOGLE_APPLICATION_CREDENTIALS
# pointing at a key file mounted into the container (see
# deployment/environments/dev/README.md, "Real cloud log sources").
DLAP_LOGINGEST_GCP_ENABLED=false
DLAP_LOGINGEST_GCP_PROJECTS=
DLAP_LOGINGEST_GCP_POLL_CRON='0/60 * * * * ?'
DLAP_LOGINGEST_GCP_PAGE_SIZE=500
DLAP_LOGINGEST_GCP_INITIAL_LOOKBACK_MINUTES=60
#
# AWS CloudTrail (ADR-0023). These are the log-ingest source settings and are
# separate from the discovery variables in section 5. Leave ENDPOINT, ACCESS_KEY
# and SECRET_KEY empty to use the AWS SDK default credential chain.
DLAP_LOGINGEST_AWS_ENABLED=false
DLAP_LOGINGEST_AWS_REGIONS=
DLAP_LOGINGEST_AWS_POLL_CRON='0/60 * * * * ?'
DLAP_LOGINGEST_AWS_MAX_RESULTS=50
DLAP_LOGINGEST_AWS_LOOKBACK_MINUTES=60
DLAP_LOGINGEST_AWS_ENDPOINT=
DLAP_LOGINGEST_AWS_ACCESS_KEY=
DLAP_LOGINGEST_AWS_SECRET_KEY=
#
# Synthetic-event seeder: injects about 50 demo GCS and BigQuery audit events
# through the full lifecycle with no cloud account
# (docs/launch/test-without-gcp.md). Keep false outside demos.
DLAP_LOGINGEST_DEMO_SEED_ENABLED=false

# === Unity Catalog (ADR-0029), optional ======================================
# da-catalog mirrors tabular assets into a Unity Catalog metastore and da-discovery
# can crawl one. Bring the server up with the `unity` compose profile; inside the
# compose network it is http://unitycatalog:8080/api/2.1/unity-catalog (from the
# host it is published on http://localhost:18080).
DLAP_UNITY_ENABLED=false
DLAP_UNITY_URI=http://unitycatalog:8080/api/2.1/unity-catalog
DLAP_UNITY_TOKEN=
DLAP_UNITY_CATALOG=dlap
DLAP_UNITY_SCHEMA=default
CLOUD_PROVIDER_UNITY_ENABLED=false
CLOUD_PROVIDER_UNITY_URI=http://unitycatalog:8080/api/2.1/unity-catalog
CLOUD_PROVIDER_UNITY_TOKEN=

# === Host port overrides (dev compose pair, e2e harnesses) ====================
# The host side of every port the dev compose publishes. The values below are the ones the
# stack has always used, so leaving them alone changes nothing. Change one when another
# program on your machine already holds the port. The container side never moves, and the
# services reach each other by compose name and internal port whatever you set here.
# Kafka is the one exception: the broker's host listener binds and advertises the same
# number, so DLAP_PORT_KAFKA also moves it inside the container.
# e2e-tests/harness-lib.sh reads the same names for the harness curl URLs, and exports them
# before it calls compose, so they come from the environment, not from this file, in a harness run.
DLAP_PORT_POSTGRES=5432
DLAP_PORT_KEYCLOAK=8180
DLAP_PORT_KEYCLOAK_HTTPS=8443
DLAP_PORT_KAFKA=9092
DLAP_PORT_KAFKA_CONTROLLER=9093
DLAP_PORT_NEW_UI=3000
DLAP_PORT_GATEWAY=8081
DLAP_PORT_DISCOVERY=8091
DLAP_PORT_CATALOG=8082
DLAP_PORT_POLICYENGINE=8083
DLAP_PORT_REPORTING=8084
DLAP_PORT_AUTOLABEL=8085
DLAP_PORT_AUTOARCHIVAL=8086
DLAP_PORT_AUTODELETE=8087
DLAP_PORT_AUTOCOMPLIANCE=8088
DLAP_PORT_ADMIN=8089
DLAP_PORT_LOGINGEST=8090
DLAP_PORT_OLLAMA=11434
# Optional profiles: monitoring (Prometheus, Grafana), aws (LocalStack), unity (Unity Catalog).
DLAP_PORT_PROMETHEUS=9090
DLAP_PORT_GRAFANA=3001
DLAP_PORT_LOCALSTACK=4566
DLAP_PORT_UNITYCATALOG=18080

# === 7. Host-run services only (./gradlew :<service>:bootRun) ================
# Ignored by the dev compose pair.
# da-admin-service on the host has no defaults for DLAP_ENCRYPTION_KEY (section 3),
# KEYCLOAK_ADMIN_USER and KEYCLOAK_ADMIN_PASSWORD: export all three yourself.
DB_HOST=localhost
DB_PORT=5432
DB_USER=da_catalog_user
DB_PASS=changeme
DB_POOL_SIZE=10
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_CLIENT_SECRET=
SPRING_PROFILES_ACTIVE=dev
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
ADMIN_SERVICE_URL=http://localhost:8089
CATALOG_SERVICE_URL=http://localhost:8082
# da-autolabel (LLM). Gemini was removed per ADR-0009; v0.1.0 ships OpenAI and Ollama.
DLAP_AUTOLABEL_ALLOW_MOCK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30000
# da-autodelete
AUTODELETE_DEFAULT_PROVIDER=GCP
DLAP_AUTODELETE_AWS_MOCK_MODE=false
DLAP_AUTODELETE_GCP_MOCK_MODE=false
DLAP_AUTODELETE_AZURE_MOCK_MODE=false
