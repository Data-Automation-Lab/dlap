{
  "TrailARN": "arn:aws:cloudtrail:us-east-1:111122223333:trail/org-trail",
  "AdvancedEventSelectors": [
    {
      "Name": "All S3 objects except scratch",
      "FieldSelectors": [
        { "Field": "eventCategory", "Equals": ["Data"] },
