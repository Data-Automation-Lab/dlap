# Docker
.dockerignore

# Cursor IDE
# Personal editor rules and agent permission lists are never shipped.
.cursor/
.claude/settings.local.json

# Production environment secrets (never commit)
deployment/environments/prod/.env*

# Key material and credentials (never commit). A TLS keystore was once tracked,
# see the "Key material previously committed" section of SECURITY.md. Operators
# supply keystores at runtime through DLAP_TLS_KEYSTORE_PATH, outside the tree.
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.pem
*.key
*.p8
