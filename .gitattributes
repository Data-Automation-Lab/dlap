# Files consumed inside Linux containers or by POSIX tooling must stay LF even on
# Windows checkouts (autocrlf turned the Postgres init script's shebang into
# "/bin/bash^M" and broke the whole stack on a fresh clone).
*.sh            text eol=lf
gradlew         text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.properties    text eol=lf
*.env           text eol=lf
.env.example    text eol=lf
